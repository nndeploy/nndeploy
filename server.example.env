# nndeploy Server 环境变量模板，可提交到 Git；不要在此填写真实凭据。
# 在项目根目录复制模板，再编辑 server.env 填入实际配置：
#   cp server.example.env server.env
#   chmod 600 server.env
# server.env 已被 Git 忽略，并被 Docker 和 Python 打包规则排除。
# Server 启动时自动读取当前工作目录的 server.env；已有环境变量优先。
# 文件不存在时保持原有启动行为，也可以手动加载供其他程序使用：
#   set -a
#   source ./server.env
#   set +a
# 不搜索父目录或通用 .env；不执行 shell 命令，不展开值中的 ${...}。
# 真实 server.env 不应提交或复制到镜像中。
# 值中含空格、$、# 等字符时使用单引号；URL 中的特殊密码字符需 URL 编码。

# PostgreSQL：postgresql://USER:PASSWORD@HOST:5432/DATABASE
# 启动时显式传入 --database-url-env DATABASE_URL。
DATABASE_URL=''

# Redis 连接由 redis.json 中的 "url_env": "REDIS_URL" 引用。
REDIS_URL='redis://127.0.0.1:6379/0'
# 以下两个变量不会自动应用；将值填入 redis.json 的对应字段：
# REDIS_PREFIX -> namespace；REDIS_STREAM_PREFIX -> event_stream_prefix。
REDIS_PREFIX='nndeploy:dev'
REDIS_STREAM_PREFIX='nndeploy_dev:run_stream:'

# 腾讯云 COS：密钥仅由配置中的环境变量名称引用。
# cos.json: backend=cos, access_key_env=COS_ACCESS_KEY_ID,
# secret_key_env=COS_ACCESS_KEY_SECRET。
COS_ACCESS_KEY_ID=''
COS_ACCESS_KEY_SECRET=''
# 将 bucket、region 的值填入 cos.json；JSON 不自动展开环境变量。
COS_BUCKET_NAME=''
# COS_BUCKET 是可选的桶名称别名，使用时应与 COS_BUCKET_NAME 保持一致。
COS_BUCKET=''
COS_REGION='ap-beijing'
# 临时凭据可填写 token，并在 cos.json 中设置 "token_env": "COS_SESSION_TOKEN"。
COS_SESSION_TOKEN=''

# 管理令牌：启动时传入 --admin-token-env NNDEPLOY_ADMIN_TOKEN。
NNDEPLOY_ADMIN_TOKEN=''

# 示例（先准备好工作流、redis.json、cos.json 并填写 server.env）：
# python server.py --api-only --workflow ./graph.json \
#   --database-url-env DATABASE_URL --redis-config ./redis.json \
#   --storage-config ./cos.json --admin-token-env NNDEPLOY_ADMIN_TOKEN
# 完整配置说明见 python/nndeploy/server/README.md。
